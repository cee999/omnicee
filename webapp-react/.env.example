# Shared-token auth for the browser dashboard (matches APP_ACCESS_TOKEN on
# the backend — see api/telegram-auth.js:validateAppToken). Leave blank in
# local dev if the backend allows unauthenticated connections when
# NODE_ENV !== 'production'.
VITE_APP_TOKEN=

# Optional absolute backend URL when the frontend is hosted separately.
# Leave blank when the API serves the built frontend from the same origin.
VITE_API_BASE=
