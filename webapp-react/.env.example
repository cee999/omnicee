# Cloudflare Pages build-time variables (Pages -> Settings -> Variables).
# Convex deployment URL (https://<name>.convex.cloud) used by the React client.
VITE_CONVEX_URL=
# Convex HTTP site (https://<name>.convex.site) - Better Auth lives here.
VITE_CONVEX_SITE_URL=
# Python engine base URL, until the dashboard is fully on Convex.
VITE_API_BASE=
# Legacy shared token (matches APP_ACCESS_TOKEN on the engine). Optional.
VITE_APP_TOKEN=

# Convex deployment env (set with `npx convex env set NAME value`, NOT here):
#   INGEST_SECRET   >= 24 chars; same value as CONVEX_INGEST_SECRET on the engine
#   SITE_URL        the Pages URL, e.g. https://omnicee.pages.dev
#   ALLOWED_EMAILS  comma-separated operator emails allowed to sign up
#   JWKS            optional static JWKS (see @convex-dev/better-auth docs)
