# ══════════════════════════════════════════════════════════════════════
#  OMNICEE — Environment Variables (pure-Python backend, single service)
#  Copy to .env for local dev, or paste into Render's dashboard for deploy.
#  Every name below maps 1:1 to a field in omnicee/config.py:Settings.
#  Anything with a default can be left blank; the feature it gates simply
#  disables itself (with a log line on boot — silence is never an output).
# ══════════════════════════════════════════════════════════════════════


# ─── 1. REQUIRED IN PRODUCTION ────────────────────────────────────────
# The service refuses to boot in NODE_ENV=production without these two.

# Shared secret for the MT5 Expert Advisor bridge (/api/ea/*). Make up any
# long random string. The EA sends it in the X-EA-Secret header.
EA_SECRET=generate-a-long-random-secret

# MongoDB Atlas connection string (signals, outcomes, telemetry persistence).
# Without it the system still trades live but nothing survives a restart.
# Template strings like mongodb+srv://user:<password>@... must have the
# <password> part replaced, and special characters URL-encoded.
MONGODB_URI=
MONGODB_DB=omnicee


# ─── 2. MT5 EA BRIDGE (broker-accurate prices + account sync) ─────────
# Broker bid/ask do NOT come from free feeds. They come from:
#   1. MetaTrader 5 → Tools → Options → Expert Advisors → allow WebRequest
#      for https://YOUR-OMNICEE-HOST
#   2. Attach mt5/OmniceeEA.mq5 to any chart
#   3. InpServerURL = your OMNICEE URL, InpEASecret = EA_SECRET above
#   4. The EA pushes ticks + /api/ea/balance account sync; gates and
#      position sizing then run on the REAL account balance.
# MT5 prices outrank every free feed (source rank 100) while fresh.

BROKER_PRICE_HOLD_MS=15000        # how long an EA tick stays authoritative
ACCOUNT_BALANCE=0                 # fallback only when no EA sync; 0 = unknown


# ─── 3. LIVE PRICES / FEEDS ───────────────────────────────────────────
# Binance + Deriv need no key (public WS). The rest are free-tier keys;
# leave blank to skip that source — it's never zero-filled or faked.

FINNHUB_API_KEY=                  # news + forex WS stream — finnhub.io
FMP_API_KEY=                      # economic calendar — financialmodelingprep.com
ALPHA_VANTAGE_API_KEY=            # news sentiment, free 25 req/day
STOCKDATA_API_TOKEN=              # stockdata.org quotes fallback
FRED_API_KEY=                     # fred.stlouisfed.org daily FX series
ALETHEIA_API_KEY=                 # UUP/USO equity proxies
PARSE_API_KEY=                    # OpenInsider (SEC Form 4) reliability
MYFXBOOK_EMAIL=                   # community sentiment
MYFXBOOK_PASSWORD=
DERIV_APP_ID=1089                 # 1089 = public sample app id

# Researched catalog candidates (see omnicee/feeds/api_vault.py):
TWELVE_DATA_API_KEY=              # note: USOIL needs a paid plan on free keys
TIINGO_API_KEY=
EODHD_API_TOKEN=

# Per-source kill switches (set 1 to disable)
DISABLE_DERIV=
DISABLE_EXCHANGERATE=
DISABLE_TREASURY=
DISABLE_YAHOO_QUOTES=
DISABLE_TRADINGVIEW=
DISABLE_BIQUOTE=
DISABLE_FRANKFURTER=


# ─── 4. MARKET UNIVERSE ───────────────────────────────────────────────
# Timeframe codes must match exactly: M1,M5,M15,M30,H1,H2,H4,H6,H8,H12,D1,W1

SYMBOLS=BTCUSDT,ETHUSDT,XAUUSD,USOIL,UUP,EURUSD,GBPUSD,USDJPY
TIMEFRAMES=M15,H1,H4,D1
DXY_SYMBOL=UUP                    # UUP ETF is the dollar-index proxy
EQUITY_INDEX_SYMBOL=SPY


# ─── 5. ENGINE + RISK ─────────────────────────────────────────────────
# Risk gates are deterministic and final — no agent or model overrides them.

DISABLE_ENGINE=false              # 1 = stateless-brain mode (no live loop)
MIN_SIGNAL_SCORE=75               # minimum consensus score to emit a signal
GOLD_MIN_SCORE=52                 # lower bar for the XAU desk profile
ANALYSIS_INTERVAL_MS=45000
ADAPTIVE_THROTTLE=true
SIGNAL_SOFT_GATES=true
REQUIRE_KILLZONE=false            # true = only fire in London/NY overlap
MAX_PRICE_AGE_MS=90000            # stale prices are never analysed

RISK_PCT_PER_TRADE=0.5
MAX_DAILY_LOSS_PCT=3.0
MAX_DRAWDOWN_PCT=10.0
MAX_CONSEC_LOSS=4
MAX_TRADES_PER_DAY=8
KELLY_FRACTION_CAP=0.25


# ─── 6. VALIDATION ENGINES (confidence must be earned) ────────────────
# A raw model score is never shown as a probability; the ensemble gate
# combines Monte Carlo + Bayesian + statistical + walk-forward layers.

BAYES_PRIOR=0.50
BAYES_MIN_POSTERIOR=0.52
MC_SIMULATIONS=5000
MC_MIN_WIN_PROB=0.55
MC_MIN_EXPECTED_R=0.3
STAT_MIN_TESTS=5
STAT_SIGNIFICANCE=0.05
WF_MIN_SAMPLES=20
WF_MIN_WFE=0.35
ENSEMBLE_MIN_CONFIDENCE=0.62
ENSEMBLE_MIN_AGENTS=3
ENSEMBLE_MIN_SCORE=60
LEARNING_MIN_SAMPLES=6
LEARNING_WARN_WIN_RATE=0.42
LEARNING_BLOCK_WIN_RATE=0.28


# ─── 7. DATABASE ──────────────────────────────────────────────────────

MONGODB_MAX_POOL=5
MONGODB_SIGNAL_TTL_DAYS=45
MONGODB_TELEMETRY_TTL_DAYS=7
DISABLE_MONGO_SIGNALS=false
CANDLE_PERSIST_INTERVAL_MS=15000


# ─── 8. AUTH / ALERTS ─────────────────────────────────────────────────

TELEGRAM_BOT_TOKEN=               # from @BotFather (/newbot)
TELEGRAM_CHAT_IDS=                # numeric IDs, comma-separated (@userinfobot)
TELEGRAM_ALLOWED_USER_IDS=        # Mini App allowlist; blank = anyone with link
GRADE_A_CHANNEL_ID=               # optional channel for Grade-A-only alerts
APP_ACCESS_TOKEN=                 # shared-secret browser login path
PUBLIC_DASHBOARD_READ=true        # GET routes open; POST/EA routes still auth
TRADINGVIEW_WEBHOOK_SECRET=
EMAIL_AUTH_REQUIRED=true
BREVO_API_KEY=
EMAIL_FROM=OMNICEE <noreply@omnicee.app>
# Or SMTP instead of Brevo:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=                      # Gmail: 16-char App Password
# SMTP_SECURE=false
ALLOW_DEV_OTP=false               # dev only: OTP in responses/logs
OTP_PEPPER=
WEB_PUSH_SUBJECT=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=


# ─── 9. SYSTEM (defaults work on Render free tier) ────────────────────

NODE_ENV=production
PORT=8000
LOG_LEVEL=info                    # debug | info | warn | error
SERVICE_NAME=omnicee-brain
CORS_ORIGIN=
API_RATE_LIMIT_PER_MIN=120
EA_RATE_LIMIT_PER_MIN=300
BRAIN_SHARED_SECRET=              # optional loopback guard for /v1/*, >= 24 chars
